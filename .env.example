# Argus — environment template. SAFE to commit (no real values).
# Copy to `.env` and fill in a key for ONE provider. `.env` is gitignored.
# `argus eval` needs no key; `argus scan` needs one.

# Pick a provider (deepseek | openai | gemini) and set the matching key below.
ARGUS_PROVIDER=deepseek
# ARGUS_MODEL=                 # optional: override the provider's default model

DEEPSEEK_API_KEY=sk-your-key-here          # default: deepseek-flash
# OPENAI_API_KEY=sk-...                     # default: gpt-4o-mini
# GEMINI_API_KEY=...                        # Google AI Studio; default: gemini-2.0-flash (free tier)
